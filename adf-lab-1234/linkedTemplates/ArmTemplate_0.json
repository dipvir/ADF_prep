			"defaultValue": "https://raw.githubusercontent.com"
		},
		"adls_adf1lab1sa_connection_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adf1lab1sa.dfs.core.windows.net/"
		}
