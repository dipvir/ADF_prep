		{
			"name": "[concat(parameters('factoryName'), '/azure_usage_dataflow')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "AzureUsage_ds",
								"type": "DatasetReference"
							},
							"name": "source"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "dynamic_destination_ds",
								"type": "DatasetReference"
							},
							"name": "sink",
							"rejectedDataLinkedService": {
								"referenceName": "adls_adf1lab1sa_connection",
								"type": "LinkedServiceReference"
							}
						}
					],
					"transformations": [
						{
							"name": "select"
						},
						{
							"name": "cast"
						},
						{
							"name": "aggregate"
						},
						{
							"name": "sort"
						},
						{
							"name": "split"
						},
						{
							"name": "cast2"
						},
						{
							"name": "union"
						},
						{
							"name": "window"
						}
					],
					"scriptLines": [
						"source(output(",
						"          SubscriptionName as string,",
						"          SubscriptionGuid as string,",
						"          Date as string,",
						"          ResourceGuid as string,",
						"          ServiceName as string,",
						"          ServiceType as string,",
						"          ServiceRegion as string,",
						"          ServiceResource as string,",
						"          Quantity as double,",
						"          Cost as double",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     limit: 3000,",
						"     ignoreNoFilesFound: false) ~> source",
						"source select(mapColumn(",
						"          Date,",
						"          ServiceName,",
						"          ServiceType,",
						"          ServiceResource,",
						"          Cost",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select",
						"split@table1 cast(output(",
						"          Date as date 'MM-dd-yyyy'",
						"     ),",
						"     errors: true) ~> cast",
						"union aggregate(groupBy(ServiceName,",
						"          ServiceResource,",
						"          Date = year(Date)),",
						"     Cost = sum(Cost)) ~> aggregate",
						"window sort(asc(ServiceName, true),",
						"     asc(running_total, true)) ~> sort",
						"select split(like(Date, '%-%'),",
						"     disjoint: false) ~> split@(table1, table2)",
						"split@table2 cast(output(",
						"          Date as date 'MM/dd/yyyy'",
						"     ),",
						"     errors: true) ~> cast2",
						"cast2, cast union(byName: true)~> union",
						"aggregate window(over(ServiceName),",
						"     asc(Cost, true),",
						"     running_total = sum(Cost)) ~> window",
						"sort sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     truncate: true,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     mapColumn(",
						"          ServiceName,",
						"          ServiceResource,",
						"          Date,",
						"          Cost,",
						"          running_total",
						"     )) ~> sink"
					]
				}
			},
			"dependsOn": []
		},
