					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "csv_dynamic_ds",
						"type": "DatasetReference",
						"parameters": {
							"container": "source-cont",
							"folder": "all_files_event"
						}
					},
					"logStorageSettings": {
						"linkedServiceName": {
							"referenceName": "adls_adf1lab1sa_connection",
							"type": "LinkedServiceReference"
						},
						"path": "deleded-files-log"
					},
					"enableLogging": true,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": false,
						"enablePartitionDiscovery": false
					}
				}
			}
		],
		"folder": {
			"name": "Advanced_Pipelines"
		},
		"annotations": []
	}
