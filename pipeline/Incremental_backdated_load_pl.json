{
	"name": "Incremental_backdated_load_pl",
	"properties": {
		"activities": [
			{
				"name": "Lookup Last Updated Date",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "src_blob_json_param_ds",
						"type": "DatasetReference",
						"parameters": {
							"Container": "source-cont",
							"Folder": "json_files",
							"File": "cdc.json"
						}
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Data Count",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Lookup Last Updated Date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase_LS",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "Select count(*) as incr_rows From dbo.Orders\nWhere last_updated > '@{activity('Lookup Last Updated Date').output.firstRow.cdc_timestamp}'",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"folder": {
			"name": "Advanced_Pipelines"
		},
		"annotations": []
	}
}