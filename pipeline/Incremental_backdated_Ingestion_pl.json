{
	"name": "Incremental_backdated_load_pl",
	"properties": {
		"activities": [
			{
				"name": "Lookup CDC Dates",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": false,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "src_blob_json_param_ds",
						"type": "DatasetReference",
						"parameters": {
							"Container": "source-cont",
							"Folder": "json_files",
							"File": "cdc.json"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Data Count",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Lookup CDC Dates",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase_LS",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "Select sum(incr_rows) as incr_rows From\n(Select count(*) as incr_rows From dbo.Orders\nWhere last_updated > '@{activity('Lookup CDC Dates').output.value[0].max_cdc_timestamp}'\nunion all\nSelect count(*) as incr_rows From dbo.Orders\nWhere last_updated <\n'@{activity('Lookup CDC Dates').output.value[0].min_cdc_timestamp}' ) as tbl\n\n",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Check For Incremental Data",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Data Count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(activity('Data Count').output.resultSets[0].rows[0].incr_rows, 0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Copy Incremental or Backdated Data",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "Select * From dbo.Orders\nWhere last_updated > '@{activity('Lookup CDC Dates').output.value[0].max_cdc_timestamp}'\nunion all\nSelect * From dbo.Orders\nWhere last_updated < '@{activity('Lookup CDC Dates').output.value[0].min_cdc_timestamp}'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "src_azure_sql_query_ds",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "dest_blob_parquet_param_ds",
									"type": "DatasetReference",
									"parameters": {
										"Container": "destination-cont",
										"Folder": "parquet_files/orders_incr_parquet_file"
									}
								}
							]
						},
						{
							"name": "update json file with max incr date",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Get max_min date",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"additionalColumns": [
										{
											"name": "max_cdc_timestamp",
											"value": {
												"value": "@activity('Get max_min date').output.resultSets[0].rows[0].max_date",
												"type": "Expression"
											}
										},
										{
											"name": "min_cdc_timestamp",
											"value": {
												"value": "@activity('Get max_min date').output.resultSets[0].rows[0].min_date",
												"type": "Expression"
											}
										}
									],
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "src_blob_json_param_ds",
									"type": "DatasetReference",
									"parameters": {
										"Container": "source-cont",
										"Folder": "json_files",
										"File": "empty.json"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "src_blob_json_param_ds",
									"type": "DatasetReference",
									"parameters": {
										"Container": "source-cont",
										"Folder": "json_files",
										"File": "cdc.json"
									}
								}
							]
						},
						{
							"name": "Get max_min date",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Copy Incremental or Backdated Data",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase_LS",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "Select max(last_updated) as max_date, min(last_updated) as min_date From dbo.Orders",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"folder": {
			"name": "Advanced_Pipelines"
		},
		"annotations": []
	}
}